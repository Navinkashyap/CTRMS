# Backend production environment — copy to `.env` on the EC2/server instance
# and fill in real values. Never commit the filled-in file.

PORT=5001
NODE_ENV=production

# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://admin.yourdomain.com,https://vms.yourdomain.com
CLIENT_ORIGIN=

# MongoDB Atlas connection string (keep existing Atlas cluster — do not migrate)
MONGODB_URI=
MONGODB_DB_NAME=sadminperfectras

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth — generate a NEW secret for production, do not reuse the local dev one.
# e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d
